{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lourd Game",
  "version": "0.1.0",
  "identifier": "com.lourd.game",
  "build": {
    "beforeDevCommand": "cd ../../web && pnpm dev:h5",
    "devUrl": "http://localhost:10086",
    "beforeBuildCommand": "cd ../../web && pnpm build:h5",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": true,
        "title": "Lourd Game",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
