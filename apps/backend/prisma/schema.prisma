// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model Project {
  id                  Int      @id @default(autoincrement())
  name                String   @unique
  description         String?
  enabled             Boolean  @default(true)
  commonBundle        String? // 共通资源包名称
  commonBundleZipUrl  String? // 共通资源包 ZIP 下载地址
  commonBundleVersion Int? // 共通资源包版本号
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // 项目的章节
  chapters Chapter[]

  // 项目使用的资源（多对多关系）
  usedResources  ProjectResourceUsage[]
  usedMaps       ProjectMapUsage[]
  usedCharacters ProjectCharacterUsage[]

  @@map("projects")
}

model User {
  id             Int      @id @default(autoincrement())
  email          String?  @unique
  password       String? // 密码哈希（仅用于管理员邮箱登录）
  wechatOpenId   String?  @unique
  wechatUnionId  String?  @unique
  wechatNickname String? // 微信昵称
  wechatAvatar   String? // 微信头像 URL
  role           UserRole @default(USER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resources Resource[]

  @@map("users")
}

model Resource {
  id           Int      @id @default(autoincrement())
  alias        String
  src          String
  bundle       String
  bundleType   String?  @default("chapter") // "common" | "chapter"
  hash         String   @unique
  fileSize     Int
  fileType     String?
  mimeType     String?
  cosKey       String?
  originalName String?
  uploaderId   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  // 被哪些项目使用（多对多关系）
  usedByProjects ProjectResourceUsage[]
  // 被哪些章节使用（多对多关系）
  usedByChapters ChapterResourceUsage[]

  @@index([bundle])
  @@index([bundleType])
  @@index([alias])
  @@index([hash])
  @@map("resources")
}

model Chapter {
  id                   Int      @id @default(autoincrement())
  projectId            Int
  name                 String
  description          String?
  order                Int      @default(0)
  enabled              Boolean  @default(true)
  requireAd            Boolean  @default(false)
  chapterBundleZipUrl  String? // 章节资源包 ZIP 下载地址
  chapterBundleVersion Int? // 章节资源包版本号
  // 章节资源包访问地址（非 ZIP），可为目录前缀
  chapterBundleUrl     String?
  // 资源包目录树 JSON（可选）
  bundleDirTree        Json?
  // 指定章节的起始 Ink 文件
  startInkId           Int?     @unique
  startInk             InkFile? @relation("ChapterStartInk", fields: [startInkId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  usedResources ChapterResourceUsage[]
  inkFiles      InkFile[]

  @@unique([projectId, order])
  @@index([projectId])
  @@index([order])
  @@map("chapters")
}

model InkFile {
  id           Int      @id @default(autoincrement())
  chapterId    Int
  filename     String
  displayName  String?
  content      String?
  compiledPath String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chapter      Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  // 与章节 startInk 的自关联
  chapterStart Chapter? @relation("ChapterStartInk")

  @@unique([chapterId, filename])
  @@index([chapterId])
  @@map("ink_files")
}

model Map {
  id             String  @id
  name           String
  bundle         String?
  backgroundType String  @default("timeSlots")
  backgroundJson Json?

  locations Location[]
  rooms     Room[]

  // 被哪些项目使用（多对多关系）
  usedByProjects ProjectMapUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id         String  @id
  map        Map     @relation(fields: [mapId], references: [id])
  mapId      String
  name       String
  iconAlias  String?
  order      Int     @default(0)
  /**
   * Sprite 配置 JSON，包含位置和尺寸信息
   * 结构: { xAlign?: number; yAlign?: number; width?: number; height?: number }
   */
  spriteJson Json?

  rooms Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id             String   @id
  map            Map?     @relation(fields: [mapId], references: [id])
  mapId          String?
  location       Location @relation(fields: [locationId], references: [id])
  locationId     String
  name           String
  isEntrance     Boolean  @default(false)
  backgroundType String   @default("timeSlots")
  backgroundJson Json?
  hotspotsJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Character {
  id      String  @id
  name    String
  age     Int?
  icon    String?
  color   String?
  enabled Boolean @default(true)
  order   Int     @default(0)

  // 被哪些项目使用（多对多关系）
  usedByProjects ProjectCharacterUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 项目使用资源的关联表
model ProjectResourceUsage {
  id         Int      @id @default(autoincrement())
  projectId  Int
  resourceId Int
  createdAt  DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([projectId, resourceId])
  @@index([projectId])
  @@index([resourceId])
  @@map("project_resource_usage")
}

// 项目使用地图的关联表
model ProjectMapUsage {
  id        Int      @id @default(autoincrement())
  projectId Int
  mapId     String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  map     Map     @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@unique([projectId, mapId])
  @@index([projectId])
  @@index([mapId])
  @@map("project_map_usage")
}

// 项目使用角色的关联表
model ProjectCharacterUsage {
  id          Int      @id @default(autoincrement())
  projectId   Int
  characterId String
  createdAt   DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([projectId, characterId])
  @@index([projectId])
  @@index([characterId])
  @@map("project_character_usage")
}

// 章节使用资源的关联表
model ChapterResourceUsage {
  id         Int      @id @default(autoincrement())
  chapterId  Int
  resourceId Int
  createdAt  DateTime @default(now())

  chapter  Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([chapterId, resourceId])
  @@index([chapterId])
  @@index([resourceId])
  @@map("chapter_resource_usage")
}

// Prompt Tag 模型（标签 Prompt）
model PromptTag {
  id          Int      @id @default(autoincrement())
  name        String // 标签名称，如 "anime", "standing", "happy"
  tagType     String // 标签类型: "action" | "status" | "style" | "appearance" | "personality"
  content     String   @db.Text // Prompt 内容
  description String? // 描述
  order       Int      @default(0) // 排序权重
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tagType])
  @@index([enabled])
  @@map("prompt_tags")
}

// Base Prompt 模型
model BasePrompt {
  id                         Int      @id @default(autoincrement())
  name                       String
  basicPrompt                String   @db.Text @map("basic_prompt") // 原 prompt 字段，重命名为 basicPrompt
  undesiredContent           String?  @db.Text
  // Vibe Transfer 参数
  normalizeReferenceStrength Boolean  @default(false)
  referenceStrength          Float? // 0-1
  informationExtracted       Float? // 0-1
  referenceImageUrl          String? // 参考图 URL
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  characterPrompts CharacterPrompt[]
  images           PromptImage[]
  variants         PromptVariant[] // 新增关联

  @@index([name])
  @@map("base_prompts")
}

// Character Prompt 模型
model CharacterPrompt {
  id                         Int      @id @default(autoincrement())
  basePromptId               Int
  name                       String
  basicPrompt                String   @db.Text @map("basic_prompt") // 原 prompt 字段，重命名为 basicPrompt
  undesiredContent           String?  @db.Text
  // Vibe Transfer 参数
  normalizeReferenceStrength Boolean  @default(false)
  referenceStrength          Float? // 0-1
  informationExtracted       Float? // 0-1
  referenceImageUrl          String? // 参考图 URL
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  basePrompt BasePrompt      @relation(fields: [basePromptId], references: [id], onDelete: Cascade)
  images     PromptImage[]
  variants   PromptVariant[] // 新增关联

  @@index([basePromptId])
  @@index([name])
  @@map("character_prompts")
}

// Prompt Variant 模型（变体）
model PromptVariant {
  id          Int     @id @default(autoincrement())
  name        String // 变体名称，如 "Default", "Standing Pose"
  description String? // 变体描述
  isDefault   Boolean @default(false) // 是否为默认变体

  // 关联到 BasePrompt 或 CharacterPrompt（二选一）
  basePromptId      Int?
  characterPromptId Int?

  // 标签ID数组和顺序（JSON格式）
  // 格式: [{"tagId": 1, "order": 0}, {"tagId": 3, "order": 1}]
  tagIds Json @default("[]")

  // 合并后的最终 Prompt（缓存）
  mergedPrompt String @db.Text

  // 合并配置（JSON）
  // 格式: {"separator": "\n", "prefix": "", "suffix": ""}
  mergeConfig Json? @default("{\"separator\": \"\\n\"}")

  order   Int     @default(0) // 排序
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联
  basePrompt      BasePrompt?      @relation(fields: [basePromptId], references: [id], onDelete: Cascade)
  characterPrompt CharacterPrompt? @relation(fields: [characterPromptId], references: [id], onDelete: Cascade)
  images          PromptImage[]

  @@index([basePromptId])
  @@index([characterPromptId])
  @@index([isDefault])
  @@map("prompt_variants")
}

// Prompt Image 模型
model PromptImage {
  id                Int      @id @default(autoincrement())
  basePromptId      Int? // 可选：直接关联到 BasePrompt（保留用于兼容）
  characterPromptId Int? // 可选：关联到 CharacterPrompt（保留用于兼容）
  variantId         Int? @map("variant_id") // 新增：关联到变体
  imageUrl          String
  generatedPrompt   String   @db.Text
  status            String   @default("uploaded") // "uploaded" | "generated"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  basePrompt      BasePrompt?      @relation(fields: [basePromptId], references: [id], onDelete: Cascade)
  characterPrompt CharacterPrompt? @relation(fields: [characterPromptId], references: [id], onDelete: Cascade)
  variant         PromptVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([basePromptId])
  @@index([characterPromptId])
  @@index([variantId])
  @@index([status])
  @@map("prompt_images")
}

// LoreBook Category 模型
model LoreBookCategory {
  id                  String  @id @default(uuid())
  name                String
  enabled             Boolean @default(true)
  createSubcontext    Boolean @default(false)
  useCategoryDefaults Boolean @default(false)
  open                Boolean @default(false)

  // Subcontext Settings (JSON 对象，包含完整的 entry 结构)
  subcontextSettings Json?

  // Category Defaults (JSON 对象，包含完整的 entry 结构)
  categoryDefaults Json?

  // Category Bias Groups (JSON 数组)
  categoryBiasGroups Json @default("[]")

  // Settings (JSON 对象)
  settings Json @default("{}")

  // Order (JSON 数组，包含 entry IDs)
  order Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries LoreBookEntry[]

  @@map("lorebook_categories")
}

// LoreBook Entry 模型
model LoreBookEntry {
  id                  String            @id @default(uuid())
  text                String            @db.Text
  displayName         String
  generationType      String? // General, Person, Place, Thing, Life, Faction, Role, Concept, History
  keys                Json // 字符串数组
  searchRange         Int               @default(1000)
  enabled             Boolean           @default(true)
  forceActivation     Boolean           @default(false)
  keyRelative         Boolean           @default(false)
  nonStoryActivatable Boolean           @default(false)
  hidden              Boolean           @default(false)
  categoryId          String?
  category            LoreBookCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Context Config (JSON 对象)
  contextConfig Json

  // Lore Bias Groups (JSON 数组)
  loreBiasGroups Json @default("[]")

  // Advanced Conditions (JSON 数组)
  advancedConditions Json @default("[]")

  lastUpdatedAt BigInt // 时间戳
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
  @@map("lorebook_entries")
}

// LoreBook Settings 模型（全局设置）
model LoreBookSettings {
  id                  Int      @id @default(autoincrement())
  lorebookVersion     Int      @default(6)
  orderByKeyLocations Boolean  @default(false)
  order               Json     @default("[]")
  settings            Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("lorebook_settings")
}
