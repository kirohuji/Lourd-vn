// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           Int       @id @default(autoincrement())
  email        String?   @unique
  password     String?   // 密码哈希（仅用于管理员邮箱登录）
  wechatOpenId String?   @unique
  wechatUnionId String?  @unique
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  resources Resource[]

  @@map("users")
}

model Resource {
  id           Int      @id @default(autoincrement())
  alias        String
  src          String
  bundle       String
  hash         String   @unique
  fileSize     Int
  fileType     String?
  mimeType     String?
  cosKey       String?
  originalName String?
  uploaderId   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([bundle])
  @@index([alias])
  @@index([hash])
  @@map("resources")
}

model ManifestBundle {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("manifest_bundles")
}

model Map {
  id             String   @id
  name           String
  bundle         String?
  backgroundType String   @default("timeSlots")
  backgroundJson Json?

  locations      Location[]
  rooms          Room[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Location {
  id        String  @id
  map       Map     @relation(fields: [mapId], references: [id])
  mapId     String
  name      String
  iconAlias String?
  order     Int     @default(0)

  rooms     Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id             String   @id
  map            Map?     @relation(fields: [mapId], references: [id])
  mapId          String?
  location       Location @relation(fields: [locationId], references: [id])
  locationId     String
  name           String
  isEntrance     Boolean  @default(false)
  backgroundType String   @default("timeSlots")
  backgroundJson Json?
  hotspotsJson   Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Character {
  id        String  @id
  name      String
  age       Int?
  icon      String?
  color     String?
  enabled   Boolean @default(true)
  order     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

