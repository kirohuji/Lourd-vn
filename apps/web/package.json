{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Taro.js frontend for NQTR game (Web + WeChat MiniProgram)",
  "templateInfo": {
    "name": "react",
    "typescript": true,
    "css": "Sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
