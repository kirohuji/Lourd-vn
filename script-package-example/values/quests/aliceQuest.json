{
  "id": "aliceQuest",
  "name": "Help Alice",
  "description": "To learn more about how the repo works, Talk to Alice. \nGoing when she is there will automatically start an \"Event\" (see aliceQuest.tsx to learn more). \nAfter that an action will be added to open the pc, in MC room. \n\n(during the quest you can talk to Alice and you will see her talking during the quests of the same Quest)",
  "image": "alice_terrace0A",
  "stages": [
    {
      "id": "talk_alice1",
      "name": "Talk to Alice",
      "description": "Talk to Alice on the terrace",
      "onStart": [
        {
          "type": "addCommitment",
          "commitmentId": "alice_quest_talk"
        }
      ]
    },
    {
      "id": "order_products",
      "name": "Order products",
      "description": "Order the products with your PC",
      "onStart": [
        {
          "type": "addActivity",
          "activityId": "order_product",
          "roomId": "mc_room"
        }
      ]
    },
    {
      "id": "take_products",
      "name": "Take products",
      "description": "Take products on the Terrace",
      "requestDescriptionToStart": "Wait for the products you ordered to arrive (2 day)",
      "deltaDateRequired": 2,
      "onStart": [
        {
          "type": "addActivity",
          "activityId": "take_product",
          "roomId": "terrace"
        },
        {
          "type": "notify",
          "message": "You can take the products on the Terrace"
        }
      ]
    },
    {
      "id": "talk_alice2",
      "name": "Talk to Alice",
      "description": "Talk to Alice on the terrace"
    }
  ],
  "onStart": [
    {
      "type": "notify",
      "message": "{{notify_quest_is_started}}",
      "params": {
        "quest": "{{quest.name}}"
      }
    }
  ],
  "onNextStage": [
    {
      "type": "notify",
      "message": "{{notify_quest_is_updated}}",
      "params": {
        "quest": "{{stage.name}}"
      }
    }
  ],
  "commitments": [
    {
      "id": "alice_quest_talk",
      "characterId": "alice",
      "roomId": "terrace",
      "timeSlot": {
        "from": 10,
        "to": 20
      },
      "image": {
        "type": "timeSlots",
        "morning": "alice_terrace0A",
        "afternoon": "alice_terrace0A",
        "evening": "alice_terrace0A",
        "night": "alice_terrace0A"
      },
      "executionType": "automatic",
      "priority": 1,
      "onRun": [
        {
          "type": "navigate",
          "route": "/narration"
        },
        {
          "type": "jumpLabel",
          "labelKey": "talkAliceQuest"
        },
        {
          "type": "removeCommitment",
          "commitmentId": "alice_quest_talk"
        }
      ]
    }
  ]
}

